NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://pulsechat:pulsechat_local@localhost:5432/pulsechat
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
UPLOAD_SECRET=replace-with-another-32-random-characters
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
TRUST_PROXY=0
UPLOAD_DIR=./uploads
LOG_LEVEL=info
# Optional cloud deployment. Keep local defaults for development.
SERVE_FRONTEND=false
STORAGE_DRIVER=local
SUPABASE_STORAGE_BUCKET=pulsechat-files
# Set these only when STORAGE_DRIVER=supabase; keep the key server-side.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-key
# Set explicitly before running db:seed; demo users are never created at startup.
SEED_PASSWORD=PulseChat-demo-2026!
